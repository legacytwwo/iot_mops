ENVIRONMENT=prod
HTTP_SERVER_ADDRESS=0.0.0.0
HTTP_SERVER_PORT=8080

MONGO_DB=iot
MONGO_CONNECT_TIMEOUT=5s
MONGO_MIGRATE_ON_START=true
MONGO_MIGRATE_LOCK_TTL=1m

REDIS_ADDR=redis:6379
REDIS_DB=0

RABBIT_EXCHANGE=telemetry
RABBIT_EXCHANGE_TYPE=direct
RABBIT_QUEUE=telemetry.envelopes
RABBIT_ROUTING_KEY=telemetry.envelopes
RABBIT_PREFETCH=4
RABBIT_CONSUMER_TAG=rule-engine

RABBIT_RETRY_EXCHANGE=telemetry.retry
RABBIT_RETRY_EXCHANGE_TYPE=direct
RABBIT_RETRY_QUEUE=telemetry.envelopes.retry
RABBIT_RETRY_ROUTING_KEY=telemetry.envelopes.retry

RABBIT_DLX_EXCHANGE=telemetry.dlq
RABBIT_DLX_EXCHANGE_TYPE=direct
RABBIT_DLQ_QUEUE=telemetry.envelopes.dlq
RABBIT_DLQ_ROUTING_KEY=telemetry.envelopes.dlq

RABBIT_RETRY_BASE_DELAY=5s
RABBIT_RETRY_MAX_DELAY=60s
RABBIT_RETRY_MAX_ATTEMPTS=5
RABBIT_RETRY_JITTER=0.2

WORKER_CONCURRENCY=2
